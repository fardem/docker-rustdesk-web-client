# Kopieren Sie diese Datei nach .env. Docker Compose und build.sh laden sie.

# Lokales Image und lokaler Container
IMAGE_NAME=rustdesk-web-client
CONTAINER_NAME=rustdesk-web-client
WEB_PORT=5000

# RustDesk-Backend, das der Nginx-Proxy verwendet.
# Nur einen Hostnamen oder eine IP-Adresse angeben, ohne Schema und ohne Port.
BACKEND_HOST=127.0.0.1
PROTO=http

# Quelle des Web-Clients
RUSTDESK_REPO=MonsieurBiche/rustdesk-web-client
RUSTDESK_TAG=fix-build
RUSTDESK_COMMIT=
RUSTDESK_EXPECTED_COMMIT=525b5e561faf824850c71500adf463e4e0a504d4
ENABLE_WSS=true
FLUTTER_VERSION=3.22.1
RUST_VERSION=1.97.0

# Für einen anderen Branch oder ein anderes Repository passen Sie RUSTDESK_REPO
# und RUSTDESK_TAG an. RUSTDESK_COMMIT kann leer bleiben oder den festzunagelnden
# SHA enthalten.
# Beispiele:
# RUSTDESK_TAG=enable-wss
# RUSTDESK_TAG=add-features
# RUSTDESK_REPO=rustdesk/rustdesk
# RUSTDESK_TAG=1.4.0
